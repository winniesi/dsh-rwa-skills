{
  "name": "@local/rwa-skills",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RWA Toolbox: bundled skills + a left-sidebar launcher panel for the RWA daily-news and Jin10 calendar flows.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/**"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
